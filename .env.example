# Fill these before launch (in Vercel: Project Settings > Environment Variables).
# Leave blank to keep the site working with contact-form fallbacks.

# Business WhatsApp number with country code, digits only. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Business email, e.g. thinkableco.studio@gmail.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Calendar booking page or similar (must start with https://)
NEXT_PUBLIC_BOOKING_URL=

# Instagram profile link
NEXT_PUBLIC_INSTAGRAM_URL=

# How fast enquiries get a reply, e.g. "a few hours" or "one working day"
NEXT_PUBLIC_REPLY_TIME=

# Enquiry form email (server only, never shown to visitors)
# Free key from resend.com. Without a verified domain, Resend only delivers
# to the email address you signed up with, which is fine for receiving enquiries.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Optional. Defaults to Resend's test sender.
ENQUIRY_FROM_EMAIL=

# Live site address
NEXT_PUBLIC_SITE_URL=https://thinkableco.vercel.app
